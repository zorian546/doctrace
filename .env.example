# Copy to .env and fill in real values. .env itself must never be committed.

# Qdrant connection (use https://... for a cloud cluster, http://localhost:6333 for a local one)
QDRANT_URL=
QDRANT_API_KEY=

# Optional: require this value in an X-API-Key header on POST /v1/ask.
# Set it whenever the service is reachable by anyone but you.
DOCTRACE_API_KEY=

# Optional service settings (defaults shown)
# DOCTRACE_HOST=127.0.0.1
# DOCTRACE_PORT=8000
# DOCTRACE_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Optional: make the dashboard call the HTTP service instead of loading the models itself
# DOCTRACE_API_URL=http://localhost:8000
